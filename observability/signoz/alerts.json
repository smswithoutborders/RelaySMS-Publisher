              "legend": ""
            }
          }
        ],
        "panelType": "graph",
        "queryType": "builder",
        "unit": "ns"
      },
      "alertOnAbsent": false,
      "absentFor": 0,
      "seasonality": "",
      "selectedQueryName": "A",
      "thresholds": {
        "kind": "basic",
        "spec": [
          {
            "name": "warning",
            "target": 30,
            "targetUnit": "s",
            "recoveryTarget": null,
            "matchType": "at_least_once",
            "op": "above",
            "channels": []
          }
        ]
      }
    },
    "annotations": {
      "summary": "Publishing to $publication.platform took {{$value}} (95th percentile). The platform or its adapter is slow.",
      "description": "Publishing to $publication.platform took {{$value}} (95th percentile). The platform or its adapter is slow."
    },
    "disabled": false,
    "evaluation": {
      "kind": "rolling",
      "spec": {
        "evalWindow": "15m0s",
        "frequency": "1m"
      }
    },
    "schemaVersion": "v2alpha1",
    "notificationSettings": {
      "groupBy": [
        "publication.platform"
      ],
      "usePolicy": false,
      "newGroupEvalDelay": "0s",
      "renotify": {
        "enabled": false,
        "interval": "30m",
        "alertStates": []
      }
    }
  }
]
