# Server Configuration
MODE=development

# REST API
HOST=127.0.0.1
PORT=16000

# gRPC
GRPC_HOST=127.0.0.1
GRPC_PORT=6000
GRPC_SSL_PORT=6001

# SSL
SSL_CERTIFICATE=
SSL_KEY=

# Requests older than this window or with replayed nonces will be rejected.
NONCE_TTL_SECONDS=600

# Database
DATABASE_DIALECT=sqlite

# Database Encryption (SQLCipher for SQLite, TDE for MySQL)
DATABASE_ENCRYPTION_ENABLED=true
# 64-char hex (32 bytes). Generate: openssl rand -hex 32
DATABASE_ENCRYPTION_KEY=

# Database Field Encryption (AES-256-GCM for sensitive columns)
DATABASE_FIELD_ENCRYPTION_ENABLED=true
# 64-char hex (32 bytes). Generate: openssl rand -hex 32
DATABASE_FIELD_ENCRYPTION_KEY=

# Data Encryption Key (DEK) - used to encrypt all private keys
# 64-char hex (32 bytes). Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=relaysms

# SQLite
SQLITE_DATABASE_PATH=data/relaysms.db

# Celery Worker
# Broker/backend type: sqlite | redis | rabbitmq
CELERY_BROKER_TYPE=sqlite
# Worker concurrency. Leave unset to use the per-broker default
# (1 for sqlite, 4 for redis/rabbitmq).
# CELERY_WORKER_CONCURRENCY=
# sqlite
CELERY_BROKER_DB_PATH=data/celery_broker.db
CELERY_RESULT_DB_PATH=data/celery_results.db
# redis
# CELERY_REDIS_URL=redis://localhost:6379/0
# rabbitmq
# CELERY_RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Celery Beat Scheduler
CELERY_BEAT_SCHEDULE_PATH=data/celerybeat-schedule
# Cron expression for cleanup jobs (5-field cron string).
CELERY_CLEANUP_CRON="0 */3 * * *"

# Payload Session Cleanup
# Max age (in hours) before an incomplete payload session is considered stale.
PAYLOAD_SESSION_MAX_AGE_HOURS=3

# Offline Payload Publishing
# Comma-separated allowlist of ingestion protocols allowed to publish offline
# payloads, e.g. smtp,sms. Empty allows all protocols (no restriction).
OFFLINE_PUBLISH_ALLOWED_PROTOCOLS=smtp

# SMTP Ingestion Transport
# Mail body must be JSON: {"address": "<phone number>", "text": "<base64 payload>"}
SMTP_TRANSPORT_ENABLED=false
SMTP_IMAP_SERVER=
SMTP_IMAP_PORT=993
SMTP_IMAP_USERNAME=
SMTP_IMAP_PASSWORD=
# Comma-separated, e.g. INBOX,Spam - catches legit mail misfiled as spam
SMTP_IMAP_MAIL_FOLDER=INBOX
# Optional mTLS client cert, only if the mail provider requires one
SMTP_TLS_CLIENT_CERTIFICATE=
SMTP_TLS_CLIENT_KEY=

# SMTP Sender Authorization
# Comma-separated allowlist of addresses and/or domains. Empty allows nothing.
SMTP_ALLOWED_SENDERS=
# authserv-id trusted for Authentication-Results verdicts (e.g. mx.google.com). Unset skips the check.
SMTP_TRUSTED_AUTHSERV_ID=
SMTP_REQUIRE_DKIM=true
SMTP_REQUIRE_SPF=true
# Additionally re-verify DKIM via DNS (defense-in-depth)
SMTP_VERIFY_DKIM_INDEPENDENTLY=false

# Twilio Inbound SMS Transport
# Exposes POST /v1/twilio-sms for Twilio's messaging webhook.
# Requests must carry a valid X-Twilio-Signature, checked against TWILIO_AUTH_TOKEN.
TWILIO_SMS_TRANSPORT_ENABLED=false
TWILIO_AUTH_TOKEN=

# Platform Adapters
PLATFORMS_ADAPTERS_DIR=platforms/adapters
PLATFORMS_ADAPTERS_VENV_DIR=platforms/adapters_venv
PLATFORMS_ADAPTERS_ASSETS_DIR=platforms/adapters_assets
PLATFORMS_REGISTRY_FILE=platforms/registry.json

# Gateway Clients
GATEWAY_CLIENTS_REGISTRY_FILE=gateway_clients/registry.json

# Logging
LOG_LEVEL=info

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
