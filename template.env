# Server Configuration
# MODE: Set to 'production' or 'development'
MODE=development

# REST API Configuration
# HOST: Use 127.0.0.1 for reverse proxy setup, 0.0.0.0 to expose directly
HOST=127.0.0.1
PORT=16000

# gRPC Configuration
# GRPC_HOST: Use 127.0.0.1 for reverse proxy setup, 0.0.0.0 to expose directly
GRPC_HOST=127.0.0.1
GRPC_PORT=6000
GRPC_SSL_PORT=6001

# SSL Configuration
SSL_CERTIFICATE=
SSL_KEY=

# Vault gRPC Configuration
# Connection to RelaySMS Vault services
VAULT_GRPC_HOST=localhost
VAULT_GRPC_PORT=8000
VAULT_GRPC_SSL_PORT=8001
VAULT_GRPC_INTERNAL_PORT=8443
VAULT_GRPC_INTERNAL_SSL_PORT=8444

# Database Configuration
# Use MySQL or SQLite (leave MySQL vars empty to use SQLite)
MYSQL_HOST=127.0.0.1
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=relaysms_publisher
SQLITE_DATABASE_PATH=data/publisher.sqlite

# Platform Adapters Configuration
PLATFORMS_ADAPTERS_DIR=platforms/adapters
PLATFORMS_ADAPTERS_VENV_DIR=platforms/adapters_venv
PLATFORMS_ADAPTERS_ASSETS_DIR=platforms/adapters_assets

# Logging
LOG_LEVEL=info

# Sentry Configuration (Optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
