# REST API
HOST=127.0.0.1
PORT=16000
# REST API worker processes. Default 1 under scripts/run.sh, 4 on Docker and
# server installs.
# WORKERS=

# gRPC
GRPC_HOST=127.0.0.1
GRPC_PORT=6000
GRPC_MAX_WORKERS=10
# Leave off behind a reverse proxy that terminates TLS. When on, GRPC_PORT
# serves TLS using the certificate and key files below.
GRPC_TLS_ENABLED=false
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=

# Seconds a gRPC request's timestamp may be from the server's clock, and how long
# nonces are remembered to refuse replays.
NONCE_TTL_SECONDS=600

# Database
DATABASE_DIALECT=sqlite

# Encrypt the SQLite file with SQLCipher. No effect on MySQL or PostgreSQL.
DATABASE_ENCRYPTION_ENABLED=true
# 64-char hex (32 bytes). Generate: openssl rand -hex 32
DATABASE_ENCRYPTION_KEY=

# Encrypt linked accounts' platform tokens
DATABASE_FIELD_ENCRYPTION_ENABLED=true
# 64-char hex (32 bytes). Generate: openssl rand -hex 32
DATABASE_FIELD_ENCRYPTION_KEY=

# Data encryption key: encrypts the server's private keys and keys the sender hash.
# 64-char hex (32 bytes). Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=relaysms

# Postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=relaysms

# SQLite
SQLITE_DATABASE_PATH=data/relaysms.db

# Celery Worker
# Broker/backend type: sqlite | redis | rabbitmq
CELERY_BROKER_TYPE=sqlite
# Worker concurrency. Leave unset to use the per-broker default
# (1 for sqlite, else 4).
# CELERY_WORKER_CONCURRENCY=
# sqlite
CELERY_BROKER_DB_PATH=data/celery_broker.db
CELERY_RESULT_DB_PATH=data/celery_results.db
# redis
# CELERY_REDIS_URL=redis://localhost:6379/0
# rabbitmq
# CELERY_RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Celery Beat Scheduler
CELERY_BEAT_SCHEDULE_PATH=data/celerybeat-schedule
# Cron expression for cleanup jobs (5-field cron string).
CELERY_CLEANUP_CRON="0 */3 * * *"
# Cron expression for the idle token cleanup job (5-field cron string).
CELERY_TOKEN_CLEANUP_CRON="0 3 * * *"

# Payload Session Cleanup
# Max age (in hours) before an incomplete payload session is considered stale.
PAYLOAD_SESSION_MAX_AGE_HOURS=3

# Idle Token Cleanup
# Max age (in days) since a token's last activity before it is deleted.
TOKEN_IDLE_MAX_AGE_DAYS=90

# Audit Log
# Days to keep audit events and adapter install and update jobs.
AUDIT_RETENTION_DAYS=365

# Offline Payload Publishing
# Comma-separated allowlist of ingestion protocols allowed to publish offline
# payloads, e.g. smtp,https. Empty allows every protocol.
OFFLINE_PUBLISH_ALLOWED_PROTOCOLS=smtp

# Shared secret that offline payloads over https must carry in their "tag" field.
# Required when https is allowed. 64-char hex (32 bytes).
# Generate: openssl rand -hex 32
OFFLINE_PUBLISH_SHARED_SECRET=

# SMTP Ingestion Transport
# Mail body format: docs/configuration/smtp-transport.md#message-format
SMTP_TRANSPORT_ENABLED=false
SMTP_IMAP_SERVER=
SMTP_IMAP_PORT=993
SMTP_IMAP_USERNAME=
SMTP_IMAP_PASSWORD=
# Comma-separated, such as INBOX,Spam, to catch payloads misfiled as spam
SMTP_IMAP_MAIL_FOLDER=INBOX
# Optional mTLS client cert, only if the mail provider requires one
SMTP_TLS_CLIENT_CERTIFICATE=
SMTP_TLS_CLIENT_KEY=

# SMTP Sender Authorization
# Comma-separated allowlist of addresses and/or domains. Empty allows nothing.
SMTP_ALLOWED_SENDERS=
# authserv-id trusted for Authentication-Results verdicts (e.g. mx.google.com).
# Required when SMTP_TRANSPORT_ENABLED=true
SMTP_TRUSTED_AUTHSERV_ID=
SMTP_REQUIRE_DKIM=true
SMTP_REQUIRE_SPF=true
# Also re-verify the DKIM signature against DNS
SMTP_VERIFY_DKIM_INDEPENDENTLY=false

# Platform Adapters
PLATFORMS_ADAPTERS_DIR=data/platforms/adapters
PLATFORMS_ADAPTERS_VENV_DIR=data/platforms/venvs
# Per-adapter credentials.json
PLATFORMS_ADAPTERS_CONFIG_DIR=data/platforms/config
# Per-adapter databases and other files adapters write
PLATFORMS_ADAPTERS_STATE_DIR=data/platforms/state
# Comma-separated GitHub orgs whose repos administrators may install as
# adapters over the API. Empty blocks API installs; publisher.sh platforms is unaffected.
PLATFORMS_GITHUB_ORGS=

# Auth (credentials are managed with ./publisher.sh creds)
# Comma-separated web client origins, e.g. https://console.example.com. Must be
# the same site as the API. Empty if same origin.
AUTH_WEB_ORIGINS=
# false only for local http development.
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_MAX_HOURS=12

# API docs at /docs. Development only.
API_DOCS_ENABLED=false

# Logging
LOG_LEVEL=info

# OpenTelemetry. Optional, blank disables instrumentation. See
# docs/operating/observability.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_LOGS_EXPORTER=otlp
OTEL_PYTHON_LOG_CORRELATION=true

# Uptime Kuma push-monitor heartbeats. Blank disables. See
# docs/operating/observability.md.
UPTIME_KUMA_WORKER_PUSH_URL=
UPTIME_KUMA_SMTP_PUSH_URL=
